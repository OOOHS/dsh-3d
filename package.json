{
  "name": "dsh-3d",
  "version": "0.2.3-dev.4",
  "private": true,
  "description": "A DeepSeek Harness plugin for Blender-based 3D modeling and image reconstruction.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OOOHS/dsh-3d.git"
  },
  "homepage": "https://github.com/OOOHS/dsh-3d#readme",
  "bugs": {
    "url": "https://github.com/OOOHS/dsh-3d/issues"
  },
  "type": "module",
  "main": "index.js",
  "bin": {
    "dsh-3d-setup": "scripts/setup-analysis.js"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "lib",
    "locale",
    "scripts",
    "skills",
    "requirements-analysis.txt",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs/compatibility-v0.2.3.md"
  ],
  "scripts": {
    "prepack": "node scripts/clean-package.js",
    "setup:analysis": "node scripts/setup-analysis.js",
    "test": "node --test",
    "test:blender": "RUN_BLENDER_TESTS=1 node --test test/blender.integration.test.js",
    "test:helpers": "RUN_HELPER_TESTS=1 node --test test/helpers.integration.test.js",
    "test:dsh": "node test-support/dsh-profile-smoke.js",
    "validate": "node scripts/validate-package.js",
    "test:sculpt": "RUN_SCULPT_TESTS=1 node --test test/sculpt.integration.test.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "blender",
    "3d-modeling",
    "agent-skill"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2",
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "compatible",
        "0.2.1-alpha.2": "compatible"
      },
      "dshOperations": {
        "0.2.0-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "unknown"
        },
        "0.2.1-alpha.1": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "unknown"
        },
        "0.2.1-alpha.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "unknown"
        }
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.1 || ^3.18.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
